<div class="contextual">
  <%= link_to l(:label_multiple_note_templates, default: 'Back to List'), 
              multiple_note_templates_path, 
              class: 'icon icon-list' %>
</div>

<h2><%= l(:label_multiple_note_templates_new, default: 'New Multiple Note Template') %></h2>

<%= labelled_form_for @template, url: multiple_note_templates_path do |f| %>
  <%= render partial: 'form', locals: { f: f } %>
  <p>
    <%= submit_tag l(:button_create) %>
    <%= link_to l(:button_cancel), multiple_note_templates_path %>
  </p>
<% end %>