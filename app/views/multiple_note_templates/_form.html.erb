<%= error_messages_for 'template' %>

<div class="box tabular">
  <p><%= f.text_field :name, required: true, size: 80 %></p>
  <p><%= f.check_box :enabled %></p>
  
  <p>
    <label><%= l(:label_tracker_plural) %></label>
    <% Tracker.sorted.all.each do |tracker| %>
      <label class="floating">
        <%= check_box_tag 'multiple_note_template[tracker_ids][]', 
                          tracker.id, 
                          @template.trackers.include?(tracker) %>
        <%= tracker.name %>
      </label>
    <% end %>
    <%= hidden_field_tag 'multiple_note_template[tracker_ids][]', '' %>
  </p>

  <p><%= f.hidden_field :memo, size: 80, label: l(:field_memo, default: 'Memo') %></p>
  
  <p>
    <%= f.label_for_field :description %>
    <%= f.text_area :description, cols: 60, rows: 10, class: 'wiki-edit', label: l(:field_description) %>
  </p>
</div>

<%= wikitoolbar_for 'multiple_note_template_description' %>